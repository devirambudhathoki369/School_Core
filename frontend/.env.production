# Build-time public config for production (safe to commit — NEXT_PUBLIC_* values
# are inlined into the client bundle anyway). Used by GitHub Actions `npm run build`.
NEXT_PUBLIC_BASE_URL=https://backend.nirsabi.com
NEXT_PUBLIC_BASE_LOCAL_URL=https://backend.nirsabi.com
NEXT_PUBLIC_DOMAIN=nirsabi.com
NEXT_PUBLIC_ALLOWED_ROLES=superadmin,admin,staff,student,canteen
NEXT_PUBLIC_DEFAULT_ADMIN_VIEW=dashboard
NEXT_PUBLIC_SENTRY=off
