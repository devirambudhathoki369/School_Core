From 3488be3810bcdea2b402f158ffa0351625009116 Mon Sep 17 00:00:00 2001
From: devirambudhathoki369 <devirambudhathoki369@gmail.com>
Date: Fri, 6 Nov 2026 15:28:11 +0545
Subject: [PATCH 08/10] test(mobile-api): fail when the app's API types are out
 of date

mobile_schema --check compares the committed schema with the server's and
fails, naming the two commands to run, when they differ. A test runs it on
mobile/src/api/openapi.json, so an API change without new app types breaks
the suite instead of a screen.
---
 .../management/commands/mobile_schema.py      | 24 ++++++++++++++---
 backend/mobileapi/tests/test_account.py       | 27 +++++++++++++++++++
 2 files changed, 48 insertions(+), 3 deletions(-)

diff --git a/backend/mobileapi/management/commands/mobile_schema.py b/backend/mobileapi/management/commands/mobile_schema.py
index b599151a..6dae6bdd 100644
--- a/backend/mobileapi/management/commands/mobile_schema.py
+++ b/backend/mobileapi/management/commands/mobile_schema.py
@@ -1,12 +1,15 @@
 """Write the mobile API's OpenAPI 3 schema, for the app's generated types.
 
     python manage.py mobile_schema ../mobile/src/api/openapi.json
+    python manage.py mobile_schema --check ../mobile/src/api/openapi.json
 
-The same schema is served at /api/mobile/v1/schema.
+With --check it writes nothing and fails when the file is out of date, so a
+change to the API without new app types is caught. The same schema is
+served at /api/mobile/v1/schema.
 """
 import json
 
-from django.core.management.base import BaseCommand
+from django.core.management.base import BaseCommand, CommandError
 from django.test import RequestFactory
 
 from mobileapi.schema import MobileSchemaView
@@ -17,8 +20,9 @@ class Command(BaseCommand):
 
     def add_arguments(self, parser):
         parser.add_argument("path", nargs="?", help="Where to write it; stdout when left out")
+        parser.add_argument("--check", action="store_true", help="Only compare with the file at path")
 
-    def handle(self, *args, path=None, **options):
+    def handle(self, *args, path=None, check=False, **options):
         request = RequestFactory().get("/api/mobile/v1/schema", {"format": "json"}, SERVER_NAME="localhost")
         response = MobileSchemaView.as_view()(request)
         response.render()
@@ -26,6 +30,20 @@ class Command(BaseCommand):
             raise SystemExit(f"The schema could not be made: HTTP {response.status_code}")
         schema = json.loads(response.content)
         text = json.dumps(schema, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
+        if check:
+            if not path:
+                raise CommandError("--check needs the path of the schema file.")
+            try:
+                with open(path, encoding="utf-8") as current:
+                    same = current.read() == text
+            except FileNotFoundError:
+                same = False
+            if not same:
+                raise CommandError(
+                    f"{path} is out of date. Run: python manage.py mobile_schema {path}, then npm run api-types."
+                )
+            self.stderr.write(f"{path} is up to date.")
+            return
         if path:
             with open(path, "w", encoding="utf-8") as out:
                 out.write(text)
diff --git a/backend/mobileapi/tests/test_account.py b/backend/mobileapi/tests/test_account.py
index c909a5f2..e35f02f6 100644
--- a/backend/mobileapi/tests/test_account.py
+++ b/backend/mobileapi/tests/test_account.py
@@ -73,3 +73,30 @@ class SchemaTests(MobileTestMixin, TestCase):
             for method, operation in schema["paths"][route].items():
                 codes = set(operation["responses"])
                 self.assertTrue(codes & {"200", "201", "202", "204"}, f"{method} {route} has no answer")
+
+
+class SchemaFileTests(MobileTestMixin, TestCase):
+    def test_check_passes_on_a_fresh_file_and_fails_on_a_stale_one(self):
+        import os
+        import tempfile
+
+        from django.core.management import CommandError, call_command
+
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "openapi.json")
+            call_command("mobile_schema", path, stderr=open(os.devnull, "w"))
+            call_command("mobile_schema", path, check=True, stderr=open(os.devnull, "w"))
+            with open(path, "a", encoding="utf-8") as stale:
+                stale.write(" ")
+            with self.assertRaises(CommandError):
+                call_command("mobile_schema", path, check=True, stderr=open(os.devnull, "w"))
+
+    def test_the_apps_schema_file_is_up_to_date(self):
+        import os
+
+        from django.conf import settings
+        from django.core.management import call_command
+
+        path = os.path.join(settings.BASE_DIR, "..", "mobile", "src", "api", "openapi.json")
+        if os.path.exists(path):  # a backend checked out on its own has no app
+            call_command("mobile_schema", path, check=True, stderr=open(os.devnull, "w"))
