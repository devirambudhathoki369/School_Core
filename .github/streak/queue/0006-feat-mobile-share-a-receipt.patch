From 51674bfac375bb99c60312f0e6d9c9414e83529e Mon Sep 17 00:00:00 2001
From: devirambudhathoki369 <devirambudhathoki369@gmail.com>
Date: Fri, 6 Nov 2026 15:26:51 +0545
Subject: [PATCH 06/10] feat(mobile): share a receipt

A receipt in the app can now be shared as text (number, date, student,
each fee paid and the total), for example to send to the other parent or
keep in a chat, instead of a screenshot.
---
 mobile/src/screens/child/ChildFees.tsx | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/mobile/src/screens/child/ChildFees.tsx b/mobile/src/screens/child/ChildFees.tsx
index 4c321020..a14a25d4 100644
--- a/mobile/src/screens/child/ChildFees.tsx
+++ b/mobile/src/screens/child/ChildFees.tsx
@@ -1,5 +1,5 @@
 import { useLocalSearchParams } from 'expo-router';
-import { View } from 'react-native';
+import { Share, View } from 'react-native';
 
 import { useApi } from '@/api/hooks';
 import type { FeeHistory, FeesDue, Receipt } from '@/api/types';
@@ -138,6 +138,24 @@ export function ReceiptScreen() {
                 {data.remarks}
               </T>
             ) : null}
+            <Button
+              title="Share this receipt"
+              kind="secondary"
+              icon="send"
+              onPress={() =>
+                void Share.share({
+                  message: [
+                    `Receipt ${data.receipt_no}, ${bsLong(data.date)}`,
+                    `${data.student_name}, ${data.class_name}`,
+                    ...data.lines.map((line) => `${titleCase(line.title)}: ${rupees(line.paid_paisa)}`),
+                    `Total paid: ${rupees(data.total_paid_paisa)}`,
+                    data.total_due_paisa ? `Left to pay: ${rupees(data.total_due_paisa)}` : '',
+                  ]
+                    .filter(Boolean)
+                    .join('\n'),
+                }).catch(() => undefined)
+              }
+            />
           </>
         )}
       </Loaded>
