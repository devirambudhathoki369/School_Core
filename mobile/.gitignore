.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Firebase's service-account key (Project settings → Service accounts) is
# secret; it goes to `eas credentials`, never into the repo.
*firebase-adminsdk*.json
# Firebase's Android config. The repo is public, so it stays local; EAS
# builds get it from the GOOGLE_SERVICES_JSON file variable (app.config.js).
google-services.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
.env
!.env.example

# generated by `expo prebuild` (Continuous Native Generation)
/ios
/android
