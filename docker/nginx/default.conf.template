# Docker DNS re-resolves recreated services without restarting this proxy.
resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;
client_max_body_size 25m;
proxy_http_version 1.1;
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
# Replace untrusted incoming forwarding headers.
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto ${PROXY_SCHEME};
proxy_set_header Connection "";
proxy_read_timeout 180s;

server {
    listen 8080;
    server_name _;
    location = /proxy-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        set $frontend frontend:3000;
        proxy_pass http://$frontend;
    }
}

server {
    listen 8081;
    server_name _;
    location /static/ {
        alias /srv/static/;
        add_header X-Content-Type-Options nosniff always;
    }
    location /media/ {
        alias /srv/media/;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        # Public photos/logos are read by canvas-based downloads in the frontend.
        add_header Access-Control-Allow-Origin "*" always;
    }
    # This volume is deliberately NOT mounted in nginx.
    location /private_media/ { return 404; }
    location / {
        set $backend backend:8000;
        proxy_pass http://$backend;
    }
}
