# Never log OTP contacts, push keys, or signed document credentials.
map $uri $security_log_uri {
    ~^/api/(v1/)?documents/ /api/documents/[redacted];
    default $uri;
}
log_format schoolcore '$remote_addr [$time_local] "$request_method $security_log_uri $server_protocol" $status $body_bytes_sent';
# Each server sets it: at this level the image's own `main` log, with the
# full query string, would still be written beside it.

resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;
client_max_body_size 25m;
proxy_http_version 1.1;
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header Connection "";
proxy_read_timeout 180s;
ssl_protocols TLSv1.2 TLSv1.3;
# One certificate covering both WEB_HOST and API_HOST (or a wildcard).
ssl_certificate /etc/nginx/tls/fullchain.pem;
ssl_certificate_key /etc/nginx/tls/privkey.pem;

server {
    listen 8080;
    access_log /var/log/nginx/access.log schoolcore;
    server_name _;
    location = /proxy-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / { return 404; }
}
server {
    listen 80;
    access_log /var/log/nginx/access.log schoolcore;
    server_name ${WEB_HOST};
    return 301 https://${WEB_HOST}$request_uri;
}
server {
    listen 80;
    access_log /var/log/nginx/access.log schoolcore;
    server_name ${API_HOST};
    return 301 https://${API_HOST}$request_uri;
}
server {
    listen 443 ssl;
    access_log /var/log/nginx/access.log schoolcore;
    server_name ${WEB_HOST};
    location / {
        set $frontend frontend:3000;
        proxy_pass http://$frontend;
    }
}
server {
    listen 443 ssl;
    access_log /var/log/nginx/access.log schoolcore;
    server_name ${API_HOST};
    location /static/ {
        alias /srv/static/;
        add_header X-Content-Type-Options nosniff always;
    }
    location /media/ {
        alias /srv/media/;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Access-Control-Allow-Origin "*" always;
    }
    location /private_media/ { return 404; }
    location / {
        set $backend backend:8000;
        proxy_pass http://$backend;
    }
}
