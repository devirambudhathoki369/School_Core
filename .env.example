# Copy to .env in the repository root. This file configures Docker Compose only.
COMPOSE_PROJECT_NAME=schoolcore
# Local HTTP mode accepts localhost/127.0.0.1 origins only. Disable for production.
DOCKER_LOCAL_HTTP=true
BIND_ADDRESS=127.0.0.1
WEB_PORT=18080
API_PORT=18081
PROXY_SCHEME=http
NEXT_PUBLIC_DOMAIN=http://localhost:18080
NEXT_PUBLIC_BASE_URL=http://localhost:18081
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
CSRF_TRUSTED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
# Generate four DIFFERENT secrets: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Keep SECRET_KEY and FIELD_ENCRYPTION_KEYS when importing an existing database.
SECRET_KEY=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATE_PASSWORD=
POSTGRES_PASSWORD=
POSTGRES_DB=schoolcore
FIELD_ENCRYPTION_KEYS=
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=180
# One trusted proxy (the bundled nginx); nginx replaces forwarded client IPs.
NUM_PROXIES=1
# Optional integrations. Credentials are never copied into images.
SENTRY_DSN=
FCM_URL=
SERVICE_ACCOUNT_PATH=
BUS_TRACKING_CONFIG_FILE=/run/secrets/schoolcore/bus_tracking.json
TRACKON_API=
TRACKON_USERNAME=
TRACKON_PASSWORD=
TRACKON_TOKEN=
SMS_BULK_API=
SMS_CREDITS_API=
SMS_REPORT_API=https://sms.aakashsms.com/sms/v1/report/api
ICLOCK_REQUIRE_PUSH_KEY=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_ALLOWED_ROLES=admin,staff,student,superadmin,superuser,canteen
NEXT_PUBLIC_DEFAULT_ADMIN_VIEW=dashboard
NEXT_PUBLIC_SMS_PORTAL=
NEXT_PUBLIC_SMS_TOKEN_PAGE=
NEXT_PUBLIC_SENTRY=off
NEXT_PUBLIC_SENTRY_FEEDBACK=off
NEXT_PUBLIC_SENTRY_DSN=
MAINTENANCE=off
# Production TLS override (see docker setup.md):
# WEB_HOST=school.example.com
# API_HOST=api.school.example.com
# TLS_CERT_DIR=./docker/secrets/tls
# Opt in individually, then start with: docker compose --profile jobs up -d
# Do not enable against a copied production DB unless you intend to send messages.
ENABLE_BIRTHDAY_PUSH=false
ENABLE_BIRTHDAY_SMS=false
ENABLE_ABSENT_PUSH=false
ENABLE_COLLECTION_SMS=false
ENABLE_SMS_DELIVERY_SYNC=false
